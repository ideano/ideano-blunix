{
  "name": "ideano-blunix",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/style.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/style.css --watch"
  },
  "prettier": {
    "plugins": ["prettier-plugin-tailwindcss"]
  }
}